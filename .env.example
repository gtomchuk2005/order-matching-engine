# Template for .env (gitignored). Copy this file to .env and adjust as
# needed — `cp .env.example .env`.

KAFKA_VERSION=3.9.0
REDIS_VERSION=7.4

KAFKA_HOST_PORT=19092
REDIS_HOST_PORT=6379

# Must stay fixed: only read when storage is first formatted, so changing it
# conflicts with data already in the kafka-data volume.
KAFKA_CLUSTER_ID=wh8631XfRNm0nJkz-gZreg

ORDERS_TOPIC=orders
DELTAS_TOPIC=deltas

# One partition per engine thread; raising it later remaps key->partition
# for symbols already in flight, so 3 is a deliberate choice.
TOPIC_PARTITIONS=3

TOPIC_REPLICATION=1

# The internal listener (kafka:9092), not the HOST port above — the engine
# reaches Kafka over the compose network, not from the host.
ENGINE_KAFKA_BROKERS=kafka:9092
ENGINE_KAFKA_GROUP_ID=matching-engine
ENGINE_REDIS_HOST=redis
ENGINE_REDIS_PORT=6379
