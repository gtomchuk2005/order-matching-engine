# Local-only Compose overrides. Compose auto-loads this file when present,
# layering it on top of compose.yaml — the real mechanism for structural
# local changes (.env.local is NOT auto-loaded by Compose and does nothing).
# .env is gitignored too — generated from .env.example.
compose.override.yaml
.env
